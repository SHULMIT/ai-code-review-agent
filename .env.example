# Use "development" locally. Production requires GitHub App, database, and
# Model Service configuration before the service can process review work.
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Optional fallback for one-off local troubleshooting. New code uses the
# GitHub App installation flow below.
GITHUB_TOKEN=

# GitHub App configuration.
GITHUB_APP_ID=
# Relative paths are resolved from the repository root.
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app-private-key.pem
# Optional and used only by scripts/manual_run.py. Runtime installation IDs
# come from the authenticated GitHub Webhook payload.
GITHUB_APP_INSTALLATION_ID=
# Required to accept every incoming GitHub Webhook delivery.
GITHUB_WEBHOOK_SECRET=

# Service dependencies.
DATABASE_URL=
# Defaults to a local Ollama instance (http://localhost:11434) when unset.
# Production must override this - see Settings.validate_runtime_configuration.
#
# Local Ollama (default for development):
MODEL_SERVICE_URL=
MODEL_SERVICE_MODEL_NAME=qwen2.5:7b
#
# Remote Ollama (a GPU-backed instance, faster than local CPU inference).
# Uncomment these two lines and comment out the local pair above to use it:
# MODEL_SERVICE_URL=http://192.0.2.10:11434
# MODEL_SERVICE_MODEL_NAME=qwen2.5-coder:7b
#
# 180s has headroom for a local CPU-only Ollama; lower this once running
# against a GPU-backed Model Service.
MODEL_SERVICE_TIMEOUT_SECONDS=180
# Sent as Ollama's per-request "keep_alive", overriding its 5-minute-idle
# default so the model stays loaded between review runs.
MODEL_SERVICE_KEEP_ALIVE=30m

# Optional: uses MODEL_SERVICE_URL when unset. Set this only when the
# Ollama-compatible embedding model is hosted separately from generation -
# e.g. EMBEDDING_SERVICE_URL=http://192.0.2.10:11434 to point it at the
# same remote Ollama instance as MODEL_SERVICE_URL above.
EMBEDDING_SERVICE_URL=
# Separately configurable because embeddings may run on a different host.
EMBEDDING_SERVICE_TIMEOUT_SECONDS=180

# Local development model configuration. Do not set these in production.
LLM_API_KEY=
LLM_MODEL=

# Untrusted pull-request retrieval and model-input limits.
GIT_COMMAND_TIMEOUT_SECONDS=60
MAX_REPOSITORY_SCAN_FILES=10000
MAX_REPOSITORY_FILE_BYTES=1000000
MAX_REPOSITORY_SEARCH_RESULTS=500
# Caps repository-search snippets included in each reviewer prompt.  This is
# separate from the diff budget because search results are additional context.
MAX_REPOSITORY_CONTEXT_CHARACTERS=50000
MAX_DIFF_CHARACTERS=200000
# The context window sent to the Model Service as num_ctx. Ollama defaults
# to 2048 and silently drops the beginning of longer prompts.
MODEL_CONTEXT_TOKENS=32768
# Prompt budget, kept below MODEL_CONTEXT_TOKENS so the response has room.
MAX_MODEL_INPUT_TOKENS=28000
# Comma-separated glob patterns for files to drop entirely from a PR's diff
# before it reaches any reviewer prompt - for a target repository's own
# generated/export dumps (e.g. a "full source export" file regenerated on
# every push) that would otherwise re-embed a second, differently-numbered
# copy of other changed files' source and confuse a reviewer about which
# copy and which lines are real. Repository-specific; empty by default.
# EXCLUDED_DIFF_PATHS=all_classes_code.txt
EXCLUDED_DIFF_PATHS=
# Maximum Model Service requests in flight across parallel reviewer nodes.
MAX_CONCURRENT_MODEL_CALLS=3
LOG_LEVEL=INFO

# Local-only: the Smee channel scripts/start_local_review.ps1 forwards GitHub
# Webhook deliveries through, so GitHub can reach this machine. Not read by
# the application itself (Settings has no such field) - only by that script.
# Create one channel once at https://smee.io/new and reuse its URL across
# every local restart; it is also exactly what to enter as the GitHub App's
# own Webhook URL.
SMEE_URL=
